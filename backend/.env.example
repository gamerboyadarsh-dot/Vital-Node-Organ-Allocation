# Backend Environment Variables
# To switch to PostgreSQL, change the provider in prisma/schema.prisma to "postgresql"
# and update DATABASE_URL below:
# DATABASE_URL="postgresql://user:password@localhost:5432/odrmn"

DATABASE_URL="file:./odrmn.db"
PORT=3001
NODE_ENV=production
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
