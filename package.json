{
  "name": "odrmn",
  "version": "1.0.0",
  "description": "Organ Donation & Recipient Matching Network",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "build:all": "npm --prefix frontend run build && npm --prefix backend run generate",
    "start": "node backend/server.js",
    "seed": "node backend/prisma/seed.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
